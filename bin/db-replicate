#!/usr/bin/env bash

[[ "$TRACE" ]] && set -o xtrace
set -o errexit
set -o nounset
set -o pipefail
set -o noclobber

START_TIME=$(date +%s)

declare -A SERVICE_COUNTS
declare -A ACCOUNT_IDS=(
    ["development"]="844815912454"
    ["staging"]="451934005581"
    ["uat"]="352285845378"
    ["production"]="382373577178"
)

RETRY_MAX_ATTEMPTS=${RETRY_MAX_ATTEMPTS:-6}
RETRY_INITIAL_DELAY_SECONDS=${RETRY_INITIAL_DELAY_SECONDS:-5}
SERVICES_STOPPED=false
RESTORE_PHASE=before_restore
REPLICATION_LOCK_PID=

# Operators run evaluation experiments in staging and development, so replication must not replace
# these tables. They are moved aside before the production dump is restored and moved back after it.
# Keep this list to tables that only reference each other: the dump drops the whole schema, which
# would reach anything else that depends on them. (A spec checks it against db/structure.sql.)
REPLICATION_EXCLUDED_TABLES=(
    uk.evaluation_experiments
    uk.evaluation_gold_queries
    uk.evaluation_gold_query_sets
    uk.evaluation_results
    uk.evaluation_runs
    uk.evaluation_synthetic_input_set_items
    uk.evaluation_synthetic_input_sets
    uk.tariff_knowledge_synthetic_atars
)

# Migrations that only create or change the tables above. Restoring replaces uk.schema_migrations
# with production's, which would record these as applied or unapplied according to production, not
# according to the tables kept here. Their local applied state is saved before the restore and put
# back after it. A migration for one of the tables above must be added here (a spec checks this).
REPLICATION_EXCLUDED_MIGRATIONS=(
    20260803000001_create_evaluation_experiments.rb
    20260803000002_create_evaluation_runs.rb
    20260803000003_create_evaluation_results.rb
    20260812000001_create_evaluation_gold_queries.rb
    20260817163645_add_idempotency_key_to_evaluation_runs.rb
    20260818120000_add_run_time_overrides_to_evaluation_runs.rb
    20260824120000_add_provider_calls_to_evaluation_results.rb
    20260925100000_create_tariff_knowledge_synthetic_atars.rb
    20260925110000_create_evaluation_gold_query_sets.rb
    20261007120000_add_summary_aggregates_to_evaluation_runs.rb
    20261007140000_add_pricing_known_to_evaluation_results.rb
    20261008100000_add_persona_breakdown_to_evaluation_runs.rb
    20261013090000_add_intended_result_count_to_evaluation_runs.rb
    20261014090000_add_label_to_evaluation_runs.rb
    20261015120000_create_evaluation_synthetic_input_sets.rb
    20261019120000_default_evaluation_gold_query_sets_atar_percentage.rb
    20261019130000_add_source_workbook_and_row_to_synthetic_atars.rb
    20261029120000_add_oracle_text_to_evaluation_synthetic_input_set_items.rb
)

require_env() {
    local missing=false

    for name in "$@"; do
        if [ -z "${!name:-}" ]; then
            echo "You need to set the $name environment variable." >&2
            missing=true
        fi
    done

    if [ "$missing" = true ]; then
        exit 1
    fi
}

require_known_environment() {
    if [ -z "${ACCOUNT_IDS[$ENVIRONMENT]+set}" ]; then
        echo "Unsupported ENVIRONMENT '$ENVIRONMENT'. Expected one of: ${!ACCOUNT_IDS[*]}." >&2
        exit 1
    fi
}

require_non_production_target() {
    if [ "$ENVIRONMENT" = "production" ]; then
        echo "ENVIRONMENT cannot be production for database replication." >&2
        exit 1
    fi
}

require_env \
    ENVIRONMENT \
    CLUSTER_NAME \
    SERVICES \
    DB_DUMP_USER \
    DB_DUMP_PASSWORD \
    DB_DUMP_SERVER \
    RESTORE_FILE \
    DATABASE_URL

validate_positive_integer() {
    local name=$1
    local value=${!name}

    if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
        echo "$name must be a positive integer." >&2
        exit 1
    fi
}

require_known_environment
require_non_production_target
validate_positive_integer RETRY_MAX_ATTEMPTS
validate_positive_integer RETRY_INITIAL_DELAY_SECONDS

retry_command() {
    local description=$1
    shift
    local attempt=1
    local delay=$RETRY_INITIAL_DELAY_SECONDS
    local status

    until "$@"; do
        status=$?

        if [ "$attempt" -ge "$RETRY_MAX_ATTEMPTS" ]; then
            echo "$description failed after $attempt attempts." >&2
            return "$status"
        fi

        echo "$description failed on attempt $attempt. Retrying in ${delay}s." >&2
        sleep "$delay"
        attempt=$((attempt + 1))
        delay=$((delay * 2))
    done
}

get_desired_count_for_service_once() {
    local service=$1
    local desired_count
    local status

    desired_count=$(aws ecs describe-services --cluster "$CLUSTER_NAME" \
        --services "$service" \
        --query 'services[0].desiredCount' \
        --output text)
    status=$?

    if [ "$status" -ne 0 ]; then
        return "$status"
    fi

    if [[ ! "$desired_count" =~ ^[0-9]+$ ]]; then
        echo "Desired count for $service was not numeric: $desired_count" >&2
        return 1
    fi

    echo "$desired_count"
}

get_desired_count_for_service() {
    local service=$1

    retry_command "Get desired count for $service" \
        get_desired_count_for_service_once "$service"
}

set_desired_count_for_service_to_once() {
    local service=$1
    local desired_count=$2
    local status

    aws ecs update-service --cluster "$CLUSTER_NAME" \
        --service "$service" \
        --desired-count "$desired_count" > /dev/null
    status=$?

    if [ "$status" -ne 0 ]; then
        return "$status"
    fi

    if [ "$desired_count" -eq 0 ]; then
        SERVICES_STOPPED=true
    fi

    aws ecs wait services-stable --cluster "$CLUSTER_NAME" \
        --services "$service"
    status=$?

    if [ "$status" -ne 0 ]; then
        return "$status"
    fi
}

set_desired_count_for_service_to() {
    local service=$1
    local desired_count=$2

    retry_command "Set desired count for $service to $desired_count" \
        set_desired_count_for_service_to_once "$service" "$desired_count"
}

release_replication_lock() {
    if [ -n "$REPLICATION_LOCK_PID" ]; then
        kill "$REPLICATION_LOCK_PID" 2>/dev/null || true
        wait "$REPLICATION_LOCK_PID" 2>/dev/null || true
        REPLICATION_LOCK_PID=
    fi
}

acquire_replication_lock() {
    local acquired
    local lock_query

    lock_query="SELECT pg_try_advisory_lock(hashtextextended('trade-tariff-database-replication', 0));"

    coproc REPLICATION_LOCK {
        psql -X -qAt "$DATABASE_URL"
    }

    printf '%s\n' "$lock_query" >&"${REPLICATION_LOCK[1]}"

    if ! IFS= read -r acquired <&"${REPLICATION_LOCK[0]}"; then
        echo "Failed to acquire the database replication lock." >&2
        release_replication_lock
        return 1
    fi

    if [ "$acquired" != "t" ]; then
        echo "Another database replication is already running." >&2
        release_replication_lock
        return 1
    fi
}

cleanup_on_exit() {
    local status=$?

    trap - EXIT
    release_replication_lock

    if [ "$status" -ne 0 ] && [ "$SERVICES_STOPPED" = true ]; then
        if [ "$RESTORE_PHASE" = "post_restore" ]; then
            echo "Post-restore maintenance failed after the core database committed. Leaving services stopped." >&2
            exit "$status"
        fi

        echo "Replication failed before post-restore maintenance committed. Starting stopped services before exiting." >&2

        if ! start_services; then
            echo "Failed to restart all stopped services after replication failure." >&2
        fi
    fi

    exit "$status"
}

trap cleanup_on_exit EXIT

stop_services() {
  local desired_count
  local status=0

  for service in $SERVICES; do
      if desired_count=$(get_desired_count_for_service "$service"); then
          SERVICE_COUNTS[$service]=$desired_count
      else
          status=$?
          echo "Failed to get desired count for $service." >&2
          continue
      fi

      if set_desired_count_for_service_to "$service" 0; then
          :
      else
          status=$?
          echo "Failed to stop $service." >&2
      fi
  done

  return "$status"
}

download_database_dump_once() {
  local dump_file=$1

  curl --fail --silent --show-error \
    -u "$DB_DUMP_USER":"$DB_DUMP_PASSWORD" \
    --output "$dump_file" \
    "$DB_DUMP_SERVER""$RESTORE_FILE"
}

stream_core_database_dump() {
  local dump_file=$1

  gzip -dc "$dump_file" |
    awk '
      /^-- TRADE_TARIFF_POST_RESTORE_START$/ {
        post_restore = 1
        next
      }

      !post_restore && /^VACUUM FULL ANALYZE;$/ {
        post_restore = 1
      }

      !post_restore &&
      /^DROP EVENT TRIGGER / &&
      !/^DROP EVENT TRIGGER IF EXISTS / {
        sub(/^DROP EVENT TRIGGER /, "DROP EVENT TRIGGER IF EXISTS ")
      }

      !post_restore {
        print
      }
    '
}

sql_text_array() {
  local separator=""
  local value

  printf 'ARRAY['
  for value in "$@"; do
    printf "%s'%s'" "$separator" "$value"
    separator=","
  done
  printf ']::text[]'
}

# SQL that runs before the dump. It only does anything when every excluded table exists here. In an
# environment that does not have them yet there is nothing local to keep, so production's tables and
# migration history are restored as they are.
sql_to_set_excluded_tables_aside() {
  local tables=$1
  local migrations=$2

  printf 'CREATE TEMP TABLE replication_preservation ON COMMIT DROP AS\n'
  printf '  SELECT count(*) = cardinality(%s) AS preserve\n' "$tables"
  printf '  FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace\n'
  printf "  WHERE c.relkind = 'r' AND n.nspname || '.' || c.relname = ANY (%s);\n" "$tables"
  printf 'CREATE TEMP TABLE replication_preserved_migrations(filename text) ON COMMIT DROP;\n'
  printf '%s\n' 'DO $$'
  printf 'DECLARE excluded_table text;\n'
  printf 'BEGIN\n'
  printf '  IF (SELECT preserve FROM pg_temp.replication_preservation) THEN\n'
  printf '    INSERT INTO pg_temp.replication_preserved_migrations\n'
  printf '      SELECT filename FROM uk.schema_migrations WHERE filename = ANY (%s);\n' "$migrations"
  printf '    CREATE SCHEMA replication_holding;\n'
  printf '    FOREACH excluded_table IN ARRAY %s LOOP\n' "$tables"
  printf "      EXECUTE format('ALTER TABLE %%s SET SCHEMA replication_holding', excluded_table);\n"
  printf '    END LOOP;\n'
  printf '  END IF;\n'
  printf 'END\n'
  printf '%s\n' '$$;'
}

# SQL that runs after the dump, which has created production's own copies of the excluded tables.
# They are dropped and the local ones put back, then the migration history is corrected. The dump has
# set search_path to empty by now, so every name here is schema-qualified.
sql_to_put_excluded_tables_back() {
  local tables=$1
  local migrations=$2

  printf '%s\n' 'DO $$'
  printf 'DECLARE excluded_table text;\n'
  printf 'BEGIN\n'
  printf '  IF (SELECT preserve FROM pg_temp.replication_preservation) THEN\n'
  printf "    EXECUTE 'DROP TABLE IF EXISTS ' || array_to_string(%s, ', ');\n" "$tables"
  printf '    FOREACH excluded_table IN ARRAY %s LOOP\n' "$tables"
  printf "      EXECUTE format('ALTER TABLE replication_holding.%%s SET SCHEMA %%s', split_part(excluded_table, '.', 2), split_part(excluded_table, '.', 1));\n"
  printf '    END LOOP;\n'
  printf '    DROP SCHEMA replication_holding;\n'
  printf '    DELETE FROM uk.schema_migrations WHERE filename = ANY (%s);\n' "$migrations"
  printf '    INSERT INTO uk.schema_migrations (filename)\n'
  printf '      SELECT filename FROM pg_temp.replication_preserved_migrations;\n'
  printf '  END IF;\n'
  printf 'END\n'
  printf '%s\n' '$$;'
}

# Restores in one explicit transaction. COMMIT is only written when the whole dump was read, so if
# reading it fails part-way, psql reaches the end of its input with the transaction still open and
# the database rolls it back. (psql --single-transaction would commit whatever it had been sent.)
restore_core_database_dump() {
  local dump_file=$1
  local tables
  local migrations

  tables=$(sql_text_array "${REPLICATION_EXCLUDED_TABLES[@]}")
  migrations=$(sql_text_array "${REPLICATION_EXCLUDED_MIGRATIONS[@]}")

  {
    printf 'BEGIN;\n'
    sql_to_set_excluded_tables_aside "$tables" "$migrations"

    if ! stream_core_database_dump "$dump_file"; then
      echo "Reading the database dump failed, so the restore is abandoned and nothing is committed." >&2
      exit 1
    fi

    sql_to_put_excluded_tables_back "$tables" "$migrations"
    printf 'COMMIT;\n'
  } | psql -X -v ON_ERROR_STOP=1 "$DATABASE_URL"
}

run_post_restore_maintenance() {
  psql -v ON_ERROR_STOP=1 "$DATABASE_URL" < "$(dirname "$0")/after.sql"
}

cleanup_dump_file() {
  local dump_file=$1

  retry_command "Remove temporary database dump" rm -f "$dump_file"
}

restore_database() {
  local dump_file
  local status

  dump_file=$(retry_command "Create temporary database dump file" mktemp) || return $?

  retry_command "Download database dump" download_database_dump_once "$dump_file" || {
    status=$?
    cleanup_dump_file "$dump_file" || \
      echo "Failed to remove temporary database dump $dump_file." >&2
    return "$status"
  }

  RESTORE_PHASE=core_restore

  restore_core_database_dump "$dump_file" || {
    status=$?
    cleanup_dump_file "$dump_file" || \
      echo "Failed to remove temporary database dump $dump_file." >&2
    return "$status"
  }

  RESTORE_PHASE=post_restore

  run_post_restore_maintenance || {
    status=$?
    cleanup_dump_file "$dump_file" || \
      echo "Failed to remove temporary database dump $dump_file." >&2
    return "$status"
  }

  RESTORE_PHASE=ready
  cleanup_dump_file "$dump_file"
}

start_services() {
  local status=0

  for service in $SERVICES; do
      local desired_count

      if [ -z "${SERVICE_COUNTS[$service]+set}" ]; then
          continue
      fi

      desired_count=${SERVICE_COUNTS[$service]}

      if set_desired_count_for_service_to "$service" "$desired_count"; then
          :
      else
          status=$?
          echo "Failed to start $service with desired count $desired_count." >&2
      fi
  done

  return "$status"
}

lookup_persistence_bucket() {
  local environment=$1
  local account_id=${ACCOUNT_IDS[$environment]}

  echo "s3://trade-tariff-persistence-$account_id"
}

sync_exchange_rates() {
  local source_bucket
  local target_bucket
  source_bucket="$(lookup_persistence_bucket "$1")"
  target_bucket="$(lookup_persistence_bucket "$2")"

  retry_command "Sync exchange rates from $1 to $2" \
    aws s3 sync "$source_bucket/data/exchange_rates/" "$target_bucket/data/exchange_rates/"
}

sync_delta_files() {
  local source_bucket
  local target_bucket
  source_bucket="$(lookup_persistence_bucket "$1")"
  target_bucket="$(lookup_persistence_bucket "$2")"

  retry_command "Sync taric delta files from $1 to $2" \
    aws s3 sync "$source_bucket/data/taric/" "$target_bucket/data/taric/"

  retry_command "Sync cds delta files from $1 to $2" \
    aws s3 sync "$source_bucket/data/cds/" "$target_bucket/data/cds/"
}

echo "Acquiring database replication lock"
acquire_replication_lock

echo "Stopping services $SERVICES"
stop_services

restore_database

echo "SQL backup restored successfully"

echo "Starting services  $SERVICES"
start_services
SERVICES_STOPPED=false

echo "Syncing exchange rates"

sync_exchange_rates "production" "$ENVIRONMENT"

echo "Exchange rates synced successfully"

echo "Syncing delta files"

sync_delta_files "production" "$ENVIRONMENT"

echo "Delta files synced successfully"

END_TIME=$(date +%s)
ELAPSED_TIME=$((END_TIME - START_TIME))

echo "Database replication and exchange rate syncing complete. Time: ${ELAPSED_TIME}s"
